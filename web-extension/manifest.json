{
  "manifest_version": 3,
  "name": "Noise Cancellation Live Denoiser",
  "version": "0.1.0",
  "description": "Capture microphone audio, denoise via backend, and play cleaned audio in real-time.",
  "action": {
    "default_title": "Live Denoiser",
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://*.zoom.us/*",
        "https://teams.microsoft.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  
  "host_permissions": [
    "http://localhost:8000/*",
    "http://*/*",
    "https://*/*"
  ]
}


